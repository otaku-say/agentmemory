# agentmemory environment variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# =============================================================================
# REQUIRED — Gemini Embedding API
# Get free key: https://aistudio.google.com/apikey
# =============================================================================
GEMINI_API_KEY=your_gemini_api_key_here

# =============================================================================
# SECURITY — API secret for accessing agentmemory REST API
# If left empty, one is auto-generated and stored at /data/.agentmemory_secret
# Generate: openssl rand -hex 32
# =============================================================================
AGENTMEMORY_SECRET=

# =============================================================================
# LLM (optional) — enables AI-powered memory compression
# Set one of the following:
# =============================================================================
# Option A: Your OpenAI-compatible API
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Enable auto-compression (requires LLM key above)
AGENTMEMORY_AUTO_COMPRESS=false

# =============================================================================
# PORT MAPPING (optional, change only if 3111/3113 are occupied on your server)
# =============================================================================
III_REST_PORT=3111
III_VIEWER_PORT=3113

# =============================================================================
# STORAGE (optional)
# =============================================================================
AGENTMEMORY_STATE_BACKEND=file
AGENTMEMORY_STATE_SAVE_INTERVAL_MS=2000
# For Redis backend (multi-instance):
# AGENTMEMORY_STATE_BACKEND=redis
# AGENTMEMORY_REDIS_URL=redis://redis:6379

# =============================================================================
# FEATURES (optional)
# =============================================================================
AGENTMEMORY_TOOLS=all
AGENTMEMORY_INJECT_CONTEXT=false
